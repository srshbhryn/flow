opam-version: "2.0"
synopsis: "Toy OCaml networking playground (echo + proxy   server)"
description: """
A small learning-oriented OCaml project demonstrating basic TCP
   networking primitives, including a simple echo server and a TCP
   proxy server. Designed for experimentation with sockets,
   concurrency, and modular design in OCaml."""
maintainer: ["Sorush Bahariyan <sorush.bahariyan@gmail.com>"]
authors: ["Sorush Bahariyan"]
license: "MIT"
tags: ["topics" "networking" "tcp" "learning" "toy"]
homepage: "https://github.com/srshbhryn/flow"
doc: "https://srshbhryn.github.io/flow"
bug-reports: "https://github.com/srshbhryn/flow/issues"
depends: [
  "ocaml"
  "dune" {>= "3.16"}
  "base" {>= "v0.16.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/srshbhryn/flow.git"
